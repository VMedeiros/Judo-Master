# ==============================================================================
# Judô Master - .gitignore
# ==============================================================================

# Dependencies
node_modules/
.npm/

# Build output
dist/
out-tsc/
*.tsbuildinfo

# Angular
.angular/
.cache/

# Logs
logs/
*.log
npm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files
*.local
.env
.env.*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
/playwright/.cache/

# Husky internals (recreated by `npm install`)
.husky/_/

# Merge leftovers
*.orig
*.rej
