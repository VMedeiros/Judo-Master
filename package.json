{
  "name": "judo-master",
  "private": true,
  "version": "2.1.0",
  "description": "Judô Master - Técnicas de Judô por graduação de faixa",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prestart": "node scripts/generate-version.mjs",
    "start": "ng serve",
    "dev": "ng serve",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "ng build",
    "preview": "ng serve --configuration=production",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers=ChromeHeadlessCI",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "icons": "npm install --no-save sharp@^0.35.5 && node scripts/generate-icons.mjs",
    "start:e2e": "ng serve --port 3100"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.14.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "author": {
    "name": "Victor Medeiros",
    "url": "https://www.linkedin.com/in/victormedeiros95/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VMedeiros/Judo-Master.git"
  },
  "homepage": "https://vmedeiros.github.io/Judo-Master/",
  "lint-staged": {
    "*.{ts,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.html": [
      "eslint"
    ],
    "*.{css,json,md,yml}": [
      "prettier --write"
    ]
  }
}
